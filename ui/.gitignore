# =========================
# UI (Vite + React) - Production Gitignore
# =========================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Env & secrets (Vite uses VITE_ prefix)
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cache
.eslintcache
.cache/
.parcel-cache/
.turbo/
.vite/
tmp/
temp/
